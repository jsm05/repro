diff --git a/tests/test_money_roundtrip.py b/tests/test_money_roundtrip.py
new file mode 100644
--- /dev/null
+++ b/tests/test_money_roundtrip.py
@@ -0,0 +1,14 @@
+from money.format import format_cents
+from money.parse import to_cents
+
+
+def test_single_digit_fraction():
+    assert to_cents("12.5") == 1250
+
+
+def test_cents_are_zero_padded():
+    assert format_cents(105) == "$1.05"
+
+
+def test_roundtrip():
+    assert format_cents(to_cents("$0.5")) == "$0.50"
